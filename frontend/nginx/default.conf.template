# Rendered by the nginx image entrypoint (envsubst) at container start,
# so one image works with any backend/storage address (ConfigMap-friendly).

# Keep the original scheme when a TLS proxy (Caddy / Ingress) sits in front of nginx.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;

    # Upstreams are resolved per request (via variables) instead of once at startup,
    # so nginx starts even if backend/storage are not up yet. Note: nginx ignores
    # resolv.conf search domains — in Kubernetes use FQDNs in BACKEND_URL / MEDIA_URL
    # (e.g. http://backend.fruchi.svc.cluster.local:8000).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_URL};
    set $media_upstream ${MEDIA_URL};
    server_name _;
    root /usr/share/nginx/html;

    client_max_body_size 20m;

    # Behind a reverse proxy on a private network (Caddy in docker-compose, Ingress in
    # Kubernetes) take the visitor's address from X-Forwarded-For, so the backend's rate
    # limits count each visitor separately instead of the proxy as one client.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # Server-Sent Events (live orders in the admin panel) must not be buffered.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Generated by the backend from the catalog (storefront only; harmless on admin).
    location = /sitemap.xml {
        proxy_pass $backend_upstream/api/v1/sitemap.xml;
        proxy_set_header Host $host;
    }

    location /media/ {
        rewrite ^/media/(.*)$ /${MEDIA_BUCKET}/$1 break;
        proxy_pass $media_upstream;
        expires 7d;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # How page URLs are served differs per app: nginx/<app>.locations.conf.
    include /etc/nginx/app-locations.conf;
}
